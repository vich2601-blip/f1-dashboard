# OpenF1 real-time data credentials
#
# Export these values in your shell or configure them in your deployment. This
# project does not load .env files automatically, which keeps credentials out
# of the application source tree.
#
# Option 1: provide a short-lived OAuth access token (expires in about an hour)
OPENF1_ACCESS_TOKEN=
#
# Option 2: provide your OpenF1 account credentials so the app can obtain and
# refresh tokens automatically. Keep both values secret.
OPENF1_USERNAME=
OPENF1_PASSWORD=
